{
  "name": "dsh-cuigengji",
  "version": "0.2.3",
  "description": "催更姬：DSH 小说正文、协同规划与资料工作台",
  "type": "module",
  "main": "runtime/index.js",
  "exports": {
    ".": "./runtime/index.js",
    "./client": "./lib/client.js",
    "./core": "./runtime/core/store.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "runtime"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:rpc": "node scripts/rpc-smoke.mjs",
    "test:rpc-flow": "node scripts/rpc-flow.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "prepack": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "test:ui": "node tests/ui-smoke.mjs"
  },
  "engines": {
    "node": ">=24",
    "dsh": "0.1.7-rc.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.7-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.1.7-rc.2",
    "@deepseek-ai/dsh-skill": "0.1.7-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.2",
    "@playwright/test": "^1.55.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "@types/node": "^24.0.0"
  }
}
